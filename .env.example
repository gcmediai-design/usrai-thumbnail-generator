# Vercel 대시보드의 Environment Variables에 넣을 값 (이 파일 자체는 커밋해도 됨, 실제 키는 넣지 마세요)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ALLOWED_ORIGINS=https://your-project.vercel.app

# 저장 목록을 팀 공용으로 공유(여러 브라우저)하려면 Vercel Blob을 연결하세요.
# Vercel → Storage → Create Blob Store → 이 프로젝트에 Connect 하면 자동 생성됩니다.
BLOB_READ_WRITE_TOKEN=
